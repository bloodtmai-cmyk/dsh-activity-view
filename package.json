{
  "name": "dsh-activity-view",
  "version": "1.0.1",
  "description": "DSH Activity View — 按活跃度排列的侧栏会话列表，带项目名，当前活动会话置顶 · Sidebar activity view listing recently active sessions with their workspace, running sessions first",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "activity-view",
    "sidebar",
    "sessions"
  ],
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "compat",
    "patches",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "locale",
        "timer",
        "sessions",
        "layout",
        "uiWorkspace"
      ]
    }
  }
}
