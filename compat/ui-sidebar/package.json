{
  "name": "@local/activity-ui-sidebar",
  "description": "本地兼容层：DSH 内置侧边栏 UI（原生 bundle + sidebar.navigation.action 导航动作行插槽）的独立重命名副本",
  "version": "0.2.2-rc.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@local/activity-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ]
}
